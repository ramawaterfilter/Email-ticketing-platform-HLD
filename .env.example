# Copy to .env and fill in. Never commit .env.

DESK_ENVIRONMENT=dev                      # dev | prod
DESK_SESSION_SECRET=                      # long random text: python -c "import secrets; print(secrets.token_urlsafe(48))"
DESK_DATABASE_URL=postgresql+psycopg://desk:desk@127.0.0.1:5432/desk
DESK_PUBLIC_URL=http://localhost:5173     # the address people open in the browser

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client, type "Web application")
# Authorised redirect URI: <DESK_PUBLIC_URL>/api/v1/auth/google/callback
DESK_GOOGLE_CLIENT_ID=
DESK_GOOGLE_CLIENT_SECRET=

# Encrypts stored Gmail tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DESK_TOKEN_KEY=

DESK_ALLOWED_DOMAINS=example.com          # comma-separated Google Workspace domains allowed to sign in
DESK_BOOTSTRAP_ADMIN_EMAIL=you@example.com  # this person becomes the first admin on first sign-in

# Local development only: sign in by email without Google. Ignored when DESK_ENVIRONMENT=prod.
DESK_DEV_LOGIN_ENABLED=false

# Used by docker-compose
POSTGRES_PASSWORD=desk                    # change on a real server
# DESK_SITE_ADDRESS=desk.example.com      # production: your domain, enables automatic HTTPS
# DESK_HTTP_PORT=80
